# ForecastGuard Environment Configuration
# Copy this file to .env for local configuration.
# Never commit real credentials or secrets to version control.

# Backend Service Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend API Configuration
VITE_API_BASE_URL=http://localhost:8000

# ECMWF Data Store (ECDS) retrieval configuration. Never commit real values.
ECDS_API_URL=
ECDS_API_KEY=
